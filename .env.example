APP_ENV=development

# Generate a strong random value for real deployments.
SECRET_KEY=change-this-to-a-long-random-secret-at-least-32-characters

DATABASE_URL=postgresql+psycopg://civiclens:civiclens@db:5432/civiclens
REDIS_URL=redis://redis:6379/0

CIVICLENS_AI_ENABLED=false

CORS_ORIGINS=http://localhost:3000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_SECURE=false
MAX_UPLOAD_SIZE_MB=10

POSTGRES_DB=civiclens
POSTGRES_USER=civiclens
POSTGRES_PASSWORD=change-this-database-password

MINIO_ROOT_USER=civiclens
MINIO_ROOT_PASSWORD=change-this-minio-password

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
